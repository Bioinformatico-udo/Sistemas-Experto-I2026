{
  "questions": [
    {"fact":"numero_antenas","question":"¿Cuántos pares de antenas tiene el organismo?","options":[{"label":"Sin antenas (0 pares)","value":0},{"label":"Un par (1 par)","value":1},{"label":"Dos pares (2 pares)","value":2}],"category":"Morfología Básica"},
    {"fact":"segmento_antenal","question":"¿El segmento basal de la antena es corto o largo?","options":[{"label":"Corto","value":"corto"},{"label":"Largo","value":"largo"}],"category":"Antenas"},
    {"fact":"paredes_caparazon","question":"¿Las paredes posteriores del caparazón son incompletas o enteras?","options":[{"label":"Incompletas","value":"incompletas"},{"label":"Enteras","value":"enteras"}],"category":"Caparazón"},
    {"fact":"membranas_area_branquial","question":"¿Las membranas en el área branquial son únicas o mosaico de placas?","options":[{"label":"Única","value":"unica"},{"label":"Mosaico","value":"mosaico"}],"category":"Branquias"},
    {"fact":"superficie_quelipedo","question":"¿La superficie de los quelípedos es lisa, con granos cónicos, granos redondeados o tuberculado?","options":[{"label":"Lisa","value":"lisa"},{"label":"Granulado cónico","value":"cónico"},{"label":"Granulado redondeado","value":"redondeado"},{"label":"Tuberculado","value":"tuberculado"}],"category":"Quelípedos"},
    {"fact":"tipo_quelipedo_frente","question":"¿Los quelípedos son aplanados o robustos y cuál es la forma del frente?","options":[{"label":"Aplanados – Frente trilobulado","value":"aplanado_trilobulado"},{"label":"Robustos – Frente no prominente","value":"robusto_no"}],"category":"Quelípedos"},
