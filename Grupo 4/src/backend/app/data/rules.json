  ],
  "rules": [
    {"id":"R1","name":"Verificación de Subfilo Crustácea","description":"Si tiene 2 pares de antenas, entonces pertenece al subfilo Crustacea.","antecedents":[{"fact":"numero_antenas","operator":"==","value":2}],"consequents":[{"fact":"subfilo","value":"Crustacea"}]},
    {"id":"R2","name":"Descarte de No Crustáceos","description":"Si no tiene 2 pares de antenas, entonces no es un crustáceo.","antecedents":[{"fact":"numero_antenas","operator":"!=","value":2}],"consequents":[{"fact":"clasificacion","value":"No Crustáceo"}]},
    {"id":"R3","name":"Identificación de Familia Porcellanidae - Antena corta","description":"Segmento basal de la antena corto indica Porcellanidae.","antecedents":[{"fact":"segmento_antenal","operator":"==","value":"corto"}],"consequents":[{"fact":"familia","value":"Porcellanidae"}]},
    {"id":"R4","name":"Paredes del caparazón incompletas -> Neopisosoma","description":"Si paredes del caparazón son incompletas, posible género Neopisosoma.","antecedents":[{"fact":"paredes_caparazon","operator":"==","value":"incompletas"}],"consequents":[{"fact":"genus","value":"Neopisosoma"}]},
    {"id":"R5","name":"Membrana única -> Neopisosoma cf. neglectum","description":"Membrana única indica Neopisosoma cf. neglectum.","antecedents":[{"fact":"membranas_area_branquial","operator":"==","value":"unica"},{"fact":"genus","operator":"==","value":"Neopisosoma"}],"consequents":[{"fact":"especie_detectada","value":"Neopisosoma cf. neglectum"}]},
    {"id":"R6","name":"Membrana mosaico + granulado cónico -> Neopisosoma angustifrons","description":"Mosaico y superficie quelípedo cónico indica Neopisosoma angustifrons.","antecedents":[{"fact":"membranas_area_branquial","operator":"==","value":"mosaico"},{"fact":"superficie_quelipedo","operator":"==","value":"cónico"},{"fact":"genus","operator":"==","value":"Neopisosoma"}],"consequents":[{"fact":"especie_detectada","value":"Neopisosoma angustifrons"}]},
    {"id":"R7","name":"Membrana mosaico + granulado redondeado -> Neopisosoma orientale","description":"Mosaico y superficie quelípedo redondeado indica Neopisosoma orientale.","antecedents":[{"fact":"membranas_area_branquial","operator":"==","value":"mosaico"},{"fact":"superficie_quelipedo","operator":"==","value":"redondeado"},{"fact":"genus","operator":"==","value":"Neopisosoma"}],"consequents":[{"fact":"especie_detectada","value":"Neopisosoma orientale"}]},
    {"id":"R8","name":"Quelípedos aplanados y frente trilobulado -> Clastotoechus nodosus","description":"Identifica Clastotoechus nodosus.","antecedents":[{"fact":"tipo_quelipedo_frente","operator":"==","value":"aplanado_trilobulado"}],"consequents":[{"fact":"especie_detectada","value":"Clastotoechus nodosus"}]},
    {"id":"R9","name":"Telson 7 piezas - > Pachycheles serratus","description":"Identifica Pachycheles serratus.","antecedents":[{"fact":"piezas_telson","operator":"==","value":7},{"fact":"genus","operator":"==","value":"Pachycheles"}],"consequents":[{"fact":"especie_detectada","value":"Pachycheles serratus"}]},
    {"id":"R10","name":"Telson 5 piezas + frente avanzado -> Pachycheles monilifer","description":"Identifica Pachycheles monilifer.","antecedents":[{"fact":"piezas_telson","operator":"==","value":5},{"fact":"forma_frente_carpo","operator":"==","value":"avanzado"}],"consequents":[{"fact":"especie_detectada","value":"Pachycheles monilifer"}]},
    {"id":"R11","name":"Frente recta + carpo liso -> Pachycheles riseii","description":"Identifica Pachycheles riseii.","antecedents":[{"fact":"forma_frente_carpo","operator":"==","value":"recta"},{"fact":"superficie_quelipedo","operator":"==","value":"lisa"}],"consequents":[{"fact":"especie_detectada","value":"Pachycheles riseii"}]},
    {"id":"R12","name":"Frente recta + carpo tuberculado -> Pachycheles ackleianus","description":"Identifica Pachycheles ackleianus.","antecedents":[{"fact":"forma_frente_carpo","operator":"==","value":"recta"},{"fact":"superficie_quelipedo","operator":"==","value":"tuberculado"}],"consequents":[{"fact":"especie_detectada","value":"Pachycheles ackleianus"}]},
    {"id":"R13","name":"Diente lobuliforme + 3 dientes carpo -> Petrolisthes tridentatus","description":"Identifica Petrolisthes tridentatus.","antecedents":[{"fact":"dientes_orbitales","operator":"==","value":true},{"fact":"dientes_carpo","operator":"==","value":3}],"consequents":[{"fact":"especie_detectada","value":"Petrolisthes tridentatus"}]},
    {"id":"R14","name":"Frente triangular -> Petrolisthes tonsorius","description":"Identifica Petrolisthes tonsorius.","antecedents":[{"fact":"forma_frente_carpo","operator":"==","value":"triangular"}],"consequents":[{"fact":"especie_detectada","value":"Petrolisthes tonsorius"}]},
    {"id":"R15","name":"Telson 5 piezas -> Petrolisthes jugosus","description":"Identifica Petrolisthes jugosus.","antecedents":[{"fact":"piezas_telson","operator":"==","value":5}],"consequents":[{"fact":"especie_detectada","value":"Petrolisthes jugosus"}]},
    {"id":"R16","name":"Carpo 3 dientes -> Petrolisthes politus","description":"Identifica Petrolisthes politus.","antecedents":[{"fact":"dientes_carpo","operator":"==","value":3}],"consequents":[{"fact":"especie_detectada","value":"Petrolisthes politus"}]},
    {"id":"R17","name":"Carpo 4 dientes -> Petrolisthes armatus","description":"Identifica Petrolisthes armatus.","antecedents":[{"fact":"dientes_carpo","operator":"==","value":4}],"consequents":[{"fact":"especie_detectada","value":"Petrolisthes armatus"}]},
    {"id":"R18","name":"Sin espínulas posteriores -> Porcellana sayana","description":"Identifica Porcellana sayana.","antecedents":[{"fact":"espinas_posteriores","operator":"==","value":false}],"consequents":[{"fact":"especie_detectada","value":"Porcellana sayana"}]},
    {"id":"R_FALLBACK","name":"Fallback especie no identificada","description":"Si no se ha detectado ninguna especie, asignar especie no identificada.","antecedents":[],"consequents":[{"fact":"especie_detectada","value":"Especie no identificada"}]}
  ]
